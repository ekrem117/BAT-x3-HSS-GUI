<Project Sdk="Microsoft.NET.Sdk">

	<ItemGroup>
	  <Compile Remove="Resoruces\**" />
	  <EmbeddedResource Remove="Resoruces\**" />
	  <None Remove="Resoruces\**" />
	  <Page Remove="Resoruces\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\BatX3_HSS_GUI.Application\BatX3_HSS_GUI.Application.csproj" />
		<ProjectReference Include="..\BatX3_HSS_GUI.Infrastructure\BatX3_HSS_GUI.Infrastructure.csproj" />
		<ProjectReference Include="..\BatX3_HSS_GUI.Domain\BatX3_HSS_GUI.Domain.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<WindowsSdkPackageVersion>10.0.19041.56</WindowsSdkPackageVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>	

		<ApplicationIcon>Resources\Icons\BatX3.ico</ApplicationIcon>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

		<Version>0.1.7</Version>
	</PropertyGroup>

	<ItemGroup>
		<Resource Include="Resources\Icons\BatX3.ico" />
	</ItemGroup>
	
</Project>
