<UserControl x:Class="BatX3_HSS_GUI.Client.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="OnIsVisibleChanged"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <UserControl.Resources>

        <!-- ========================================================= -->
        <!-- DIAGNOSTIC VALUE                                          -->
        <!-- ========================================================= -->

        <Style x:Key="DiagnosticValueTextStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="FontSize"
                    Value="12" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="VerticalAlignment"
                    Value="Center" />

        </Style>

        <!-- ========================================================= -->
        <!-- CHANNEL STATUS BADGE                                      -->
        <!-- ========================================================= -->

        <Style x:Key="ChannelStatusBadgeStyle"
               TargetType="Border">

            <Setter Property="Padding"
                    Value="7,3" />

            <Setter Property="CornerRadius"
                    Value="9" />

            <Setter Property="Background"
                    Value="{DynamicResource NeutralBackgroundBrush}" />

            <Setter Property="BorderBrush"
                    Value="{DynamicResource NeutralBrush}" />

            <Setter Property="BorderThickness"
                    Value="1" />

            <Style.Triggers>

                <!-- Active -->

                <DataTrigger Binding="{Binding StateText}"
                             Value="AKTİF">

                    <Setter Property="Background"
                            Value="{DynamicResource SuccessBackgroundBrush}" />

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource SuccessBrush}" />

                </DataTrigger>

                <!-- Waiting -->

                <DataTrigger Binding="{Binding StateText}"
                             Value="BEKLİYOR">

                    <Setter Property="Background"
                            Value="{DynamicResource CorporatePrimarySoftBrush}" />

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource CorporatePrimaryBrush}" />

                </DataTrigger>

                <!-- Starting -->

                <DataTrigger Binding="{Binding StateText}"
                             Value="BAŞLATILIYOR">

                    <Setter Property="Background"
                            Value="{DynamicResource CorporatePrimarySoftBrush}" />

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource CorporatePrimaryBrush}" />

                </DataTrigger>

                <!-- Warning -->

                <DataTrigger Binding="{Binding StateText}"
                             Value="UYARI">

                    <Setter Property="Background"
                            Value="{DynamicResource WarningBackgroundBrush}" />

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource WarningBrush}" />

                </DataTrigger>

                <!-- Stale -->

                <DataTrigger Binding="{Binding StateText}"
                             Value="GÜNCEL DEĞİL">

                    <Setter Property="Background"
                            Value="{DynamicResource WarningBackgroundBrush}" />

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource WarningBrush}" />

                </DataTrigger>

                <!-- Error -->

                <DataTrigger Binding="{Binding StateText}"
                             Value="HATA">

                    <Setter Property="Background"
                            Value="{DynamicResource ErrorBackgroundBrush}" />

                    <Setter Property="BorderBrush"
                            Value="{DynamicResource ErrorBrush}" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

        <!-- ========================================================= -->
        <!-- CHANNEL STATUS TEXT                                       -->
        <!-- ========================================================= -->

        <Style x:Key="ChannelStatusTextStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource NeutralBrush}" />

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Style.Triggers>

                <DataTrigger Binding="{Binding StateText}"
                             Value="AKTİF">

                    <Setter Property="Foreground"
                            Value="{DynamicResource SuccessBrush}" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StateText}"
                             Value="BEKLİYOR">

                    <Setter Property="Foreground"
                            Value="{DynamicResource CorporatePrimaryBrush}" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StateText}"
                             Value="BAŞLATILIYOR">

                    <Setter Property="Foreground"
                            Value="{DynamicResource CorporatePrimaryBrush}" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StateText}"
                             Value="UYARI">

                    <Setter Property="Foreground"
                            Value="{DynamicResource WarningBrush}" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StateText}"
                             Value="GÜNCEL DEĞİL">

                    <Setter Property="Foreground"
                            Value="{DynamicResource WarningBrush}" />

                </DataTrigger>

                <DataTrigger Binding="{Binding StateText}"
                             Value="HATA">

                    <Setter Property="Foreground"
                            Value="{DynamicResource ErrorBrush}" />

                </DataTrigger>

            </Style.Triggers>

        </Style>

    </UserControl.Resources>

    <!-- ============================================================= -->
    <!-- CONTENT                                                       -->
    <!-- ============================================================= -->

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">

        <StackPanel Margin="0,0,10,4"
                    HorizontalAlignment="Stretch">

            <!-- ===================================================== -->
            <!-- CHANNEL HEALTH                                        -->
            <!-- ===================================================== -->

            <Border Style="{StaticResource CompactCardBorderStyle}"
                    HorizontalAlignment="Stretch">

                <StackPanel>

                    <!-- Header -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Kanal Durumu"
                                       Style="{StaticResource SectionTitleTextStyle}" />

                            <TextBlock Margin="0,3,0,0"
                                       Text="Komut, video ve tespit kanallarının çalışma durumu"
                                       Style="{StaticResource MutedTextStyle}" />

                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   VerticalAlignment="Center"
                                   Text="Canlı durum"
                                   Style="{StaticResource MutedTextStyle}" />

                    </Grid>

                    <Border Height="1"
                            Margin="0,10,0,10"
                            Background="{DynamicResource BorderBrush}" />

                    <!-- Channel cards -->

                    <ItemsControl ItemsSource="{Binding Channels}"
                                  HorizontalContentAlignment="Stretch">

                        <ItemsControl.ItemsPanel>

                            <ItemsPanelTemplate>

                                <UniformGrid Columns="3" />

                            </ItemsPanelTemplate>

                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>

                            <DataTemplate>

                                <Border Margin="4"
                                        Padding="11"
                                        Background="{DynamicResource SurfaceSecondaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                    <StackPanel>

                                        <!-- Channel header -->

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock VerticalAlignment="Center"
                                                       Text="{Binding DisplayName}"
                                                       Style="{StaticResource CardTitleTextStyle}" />

                                            <!-- Status badge -->

                                            <Border Grid.Column="1"
                                                    Style="{StaticResource ChannelStatusBadgeStyle}">

                                                <StackPanel Orientation="Horizontal">

                                                    <!-- Status dot -->

                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Margin="0,0,5,0"
                                                             VerticalAlignment="Center">

                                                        <Ellipse.Style>

                                                            <Style TargetType="Ellipse">

                                                                <Setter Property="Fill"
                                                                        Value="{DynamicResource NeutralBrush}" />

                                                                <Style.Triggers>

                                                                    <DataTrigger Binding="{Binding StateText}"
                                                                                 Value="AKTİF">

                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource SuccessBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding StateText}"
                                                                                 Value="BEKLİYOR">

                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource CorporatePrimaryBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding StateText}"
                                                                                 Value="BAŞLATILIYOR">

                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource CorporatePrimaryBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding StateText}"
                                                                                 Value="UYARI">

                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource WarningBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding StateText}"
                                                                                 Value="GÜNCEL DEĞİL">

                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource WarningBrush}" />

                                                                    </DataTrigger>

                                                                    <DataTrigger Binding="{Binding StateText}"
                                                                                 Value="HATA">

                                                                        <Setter Property="Fill"
                                                                                Value="{DynamicResource ErrorBrush}" />

                                                                    </DataTrigger>

                                                                </Style.Triggers>

                                                            </Style>

                                                        </Ellipse.Style>

                                                    </Ellipse>

                                                    <TextBlock Text="{Binding StateText}"
                                                               Style="{StaticResource ChannelStatusTextStyle}" />

                                                </StackPanel>

                                            </Border>

                                        </Grid>

                                        <!-- Endpoint -->

                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource CorporatePrimaryBrush}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding EndpointText}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding EndpointText}" />

                                        <Border Height="1"
                                                Margin="0,9,0,8"
                                                Background="{DynamicResource BorderBrush}" />

                                        <!-- Last activity -->

                                        <Grid Margin="0,0,0,6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Son aktivite"
                                                       Style="{StaticResource MutedTextStyle}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding LastActivity}"
                                                       Style="{StaticResource DiagnosticValueTextStyle}" />

                                        </Grid>

                                        <!-- Success -->

                                        <Grid Margin="0,0,0,6">

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Başarılı"
                                                       Style="{StaticResource MutedTextStyle}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding SuccessCount}"
                                                       Style="{StaticResource DiagnosticValueTextStyle}" />

                                        </Grid>

                                        <!-- Errors -->

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="Hata"
                                                       Style="{StaticResource MutedTextStyle}" />

                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ErrorCount}"
                                                       Style="{StaticResource DiagnosticValueTextStyle}" />

                                        </Grid>

                                        <!-- Last Error -->

                                        <Border Margin="0,9,0,0"
                                                Padding="7,5"
                                                CornerRadius="5">

                                            <Border.Style>

                                                <Style TargetType="Border">

                                                    <Setter Property="Visibility"
                                                            Value="Visible" />

                                                    <Setter Property="Background"
                                                            Value="{DynamicResource ErrorBackgroundBrush}" />

                                                    <Style.Triggers>

                                                        <DataTrigger Binding="{Binding LastError}"
                                                                     Value="—">

                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />

                                                        </DataTrigger>

                                                    </Style.Triggers>

                                                </Style>

                                            </Border.Style>

                                            <TextBlock FontSize="9"
                                                       Foreground="{DynamicResource ErrorBrush}"
                                                       Text="{Binding LastError}"
                                                       TextWrapping="Wrap"
                                                       MaxHeight="34"
                                                       ToolTip="{Binding LastError}" />

                                        </Border>

                                    </StackPanel>

                                </Border>

                            </DataTemplate>

                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

            <!-- ===================================================== -->
            <!-- SYNCHRONIZATION                                       -->
            <!-- ===================================================== -->

            <Border Margin="0,12,0,0"
                    Style="{StaticResource CompactCardBorderStyle}"
                    HorizontalAlignment="Stretch">

                <StackPanel>

                    <TextBlock Text="Senkronizasyon"
                               Style="{StaticResource SectionTitleTextStyle}" />

                    <TextBlock Margin="0,3,0,0"
                               Text="Video ve tespit frame eşleştirme sayaçları"
                               Style="{StaticResource MutedTextStyle}" />

                    <Border Height="1"
                            Margin="0,10,0,10"
                            Background="{DynamicResource BorderBrush}" />

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Matched -->

                        <Border Grid.Column="0"
                                Padding="12,10"
                                Background="{DynamicResource CorporatePrimarySoftBrush}"
                                CornerRadius="7">

                            <StackPanel>

                                <TextBlock Text="{Binding MatchedFrames}"
                                           Foreground="{DynamicResource CorporatePrimaryBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />

                                <TextBlock Margin="0,2,0,0"
                                           Text="Eşleşen Frame"
                                           Style="{StaticResource MutedTextStyle}" />

                            </StackPanel>

                        </Border>

                        <!-- Video Only -->

                        <Border Grid.Column="2"
                                Padding="12,10"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <StackPanel>

                                <TextBlock Text="{Binding VideoOnlyFrames}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />

                                <TextBlock Margin="0,2,0,0"
                                           Text="Yalnız Video"
                                           Style="{StaticResource MutedTextStyle}" />

                            </StackPanel>

                        </Border>

                        <!-- Dropped Detection -->

                        <Border Grid.Column="4"
                                Padding="12,10"
                                Background="{DynamicResource SurfaceSecondaryBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7">

                            <StackPanel>

                                <TextBlock Text="{Binding DroppedDetectionFrames}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="22"
                                           FontWeight="SemiBold" />

                                <TextBlock Margin="0,2,0,0"
                                           Text="Atılan Tespit"
                                           Style="{StaticResource MutedTextStyle}" />

                            </StackPanel>

                        </Border>

                    </Grid>

                    <TextBlock Margin="2,9,0,0"
                               Text="Sayaçlar uygulama çalıştığı sürece birikimli olarak güncellenir."
                               Style="{StaticResource MutedTextStyle}" />

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
