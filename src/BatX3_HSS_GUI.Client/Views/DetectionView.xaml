<UserControl x:Class="BatX3_HSS_GUI.Client.Views.DetectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <TextBlock Text="Detection Stream"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <Border Padding="20"
                BorderThickness="1">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="220" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Frame ID"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Text="{Binding FrameId}" />

                <TextBlock Grid.Row="1"
                           Text="Detection Count"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Text="{Binding DetectionCount}" />

                <TextBlock Grid.Row="2"
                           Text="Lock State"
                           Margin="0,0,0,10" />

                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Text="{Binding LockState}" />

                <TextBlock Grid.Row="3"
                           Text="Locked Track ID" />

                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           FontWeight="SemiBold"
                           Text="{Binding LockedTrackId}" />

            </Grid>

        </Border>

        <TextBlock Margin="0,12,0,0"
                   Text="{Binding StatusText}" />

    </StackPanel>

</UserControl>