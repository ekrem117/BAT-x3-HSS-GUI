<UserControl x:Class="BatX3_HSS_GUI.Client.Views.GamepadSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">

    <UserControl.Resources>

        <Style x:Key="SettingsFieldLabelStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryTextBrush}" />

            <Setter Property="FontSize"
                    Value="11" />

            <Setter Property="FontWeight"
                    Value="SemiBold" />

            <Setter Property="Margin"
                    Value="0,0,0,5" />

        </Style>

        <Style x:Key="SettingsFieldHintStyle"
               TargetType="TextBlock">

            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryTextBrush}" />

            <Setter Property="FontSize"
                    Value="10" />

            <Setter Property="TextWrapping"
                    Value="Wrap" />

        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">

        <StackPanel Margin="0,0,10,4"
                    HorizontalAlignment="Stretch">

            <Border Style="{StaticResource CompactCardBorderStyle}" HorizontalAlignment="Stretch">

                <StackPanel>

                    <!-- ================================================= -->
                    <!-- HEADER                                            -->
                    <!-- ================================================= -->

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>

                            <TextBlock Text="Gamepad" Style="{StaticResource SectionTitleTextStyle}"/>

                            <TextBlock Margin="0,3,0,0" Text="Manuel hareket, hassas kontrol ve gamepad aksiyon atamaları" Style="{StaticResource MutedTextStyle}"/>

                        </StackPanel>

                        <CheckBox Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Content="Gamepad Etkin" IsChecked="{Binding GamepadEnabled,                                                       Mode=TwoWay,                                                       UpdateSourceTrigger=PropertyChanged}"/>

                    </Grid>

                    <Border Height="1" Margin="0,10,0,10" Background="{DynamicResource BorderBrush}"/>

                    <!-- ================================================= -->
                    <!-- RUNTIME STATUS                                    -->
                    <!-- ================================================= -->

                    <Border Margin="0,0,0,10" Padding="10,8" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <!-- Runtime state -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Runtime Durumu" Style="{StaticResource SettingsFieldHintStyle}"/>

                                <TextBlock Margin="0,3,0,0" FontSize="12" FontWeight="SemiBold" Text="{Binding GamepadRuntimeStatusText}">

                                    <TextBlock.Style>

                                        <Style TargetType="TextBlock">

                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>

                                            <Style.Triggers>

                                                <DataTrigger Binding="{Binding GamepadRuntimeHasError}" Value="True">

                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>

                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding GamepadRuntimeIsReady}" Value="True">

                                                    <Setter Property="Foreground" Value="{DynamicResource CorporatePrimaryBrush}"/>

                                                </DataTrigger>

                                            </Style.Triggers>

                                        </Style>

                                    </TextBlock.Style>

                                </TextBlock>

                            </StackPanel>

                            <!-- Runtime detail -->

                            <StackPanel Grid.Column="1" Margin="16,0">

                                <TextBlock Text="Durum" Style="{StaticResource SettingsFieldHintStyle}"/>

                                <TextBlock Margin="0,3,0,0" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding GamepadRuntimeDetailText}" TextWrapping="Wrap"/>

                            </StackPanel>

                            <!-- Active runtime device -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Runtime Cihazı" Style="{StaticResource SettingsFieldHintStyle}"/>

                                <TextBlock Margin="0,3,0,0" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Text="{Binding GamepadRuntimeDeviceText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding GamepadRuntimeDeviceText}"/>

                            </StackPanel>

                        </Grid>

                    </Border>

                    <!-- ================================================= -->
                    <!-- SETTINGS BODY                                     -->
                    <!-- ================================================= -->

                    <StackPanel IsEnabled="{Binding GamepadEnabled}">

                        <!-- ================================================= -->
                        <!-- DEVICE                                            -->
                        <!-- ================================================= -->

                        <TextBlock Text="Cihaz" Style="{StaticResource CardTitleTextStyle}"/>

                        <Grid Margin="0,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Aktif Gamepad" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <ComboBox MinHeight="30" ItemsSource="{Binding GamepadDevices}" DisplayMemberPath="DisplayName" SelectedValuePath="DeviceId" SelectedValue="{Binding SelectedGamepadDeviceId,                                                                   Mode=TwoWay,                                                                   UpdateSourceTrigger=PropertyChanged}" ToolTip="Kullanılacak gamepad cihazını seçin."/>

                                <TextBlock Margin="0,4,0,0" Text="Kaydedilmiş fakat bağlı olmayan cihaz seçimi korunur." Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                            <Button Grid.Column="2" MinWidth="86" Margin="0,20,0,0" VerticalAlignment="Top" Content="Yenile" Command="{Binding RefreshGamepadDevicesCommand}" ToolTip="Bağlı gamepad cihazlarını yeniden tara." Style="{StaticResource CompactSecondaryButtonStyle}"/>

                        </Grid>

                        <!-- ================================================= -->
                        <!-- ANALOG CONTROL                                    -->
                        <!-- ================================================= -->

                        <Border Height="1" Margin="0,13,0,10" Background="{DynamicResource BorderBrush}"/>

                        <TextBlock Text="Analog Kontrol" Style="{StaticResource CardTitleTextStyle}"/>

                        <TextBlock Margin="0,3,0,0" Text="Sol analog stick pan/tilt hareketi için sabittir ve buton ataması olarak değiştirilemez." Style="{StaticResource SettingsFieldHintStyle}"/>

                        <Grid Margin="0,8,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Invert Y -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Y Ekseni" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <CheckBox Margin="0,5,0,0" Content="Y eksenini ters çevir" IsChecked="{Binding GamepadInvertY,                                                               Mode=TwoWay,                                                               UpdateSourceTrigger=PropertyChanged}"/>

                            </StackPanel>

                            <!-- Deadzone -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Ölü Bölge" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <TextBox Text="{Binding GamepadDeadzone,                                                         Mode=TwoWay,                                                         UpdateSourceTrigger=PropertyChanged}" ToolTip="Sol analog stick ölü bölgesi. 0.0 ile 1.0 arasında olmalıdır." Style="{StaticResource TextInputStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="0.0 ≤ değer &lt; 1.0" Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                            <!-- Polling -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Polling Süresi" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <TextBox Text="{Binding GamepadPollingIntervalMs,                                                         Mode=TwoWay,                                                         UpdateSourceTrigger=PropertyChanged}" ToolTip="Gamepad okuma çevrimi süresi." Style="{StaticResource TextInputStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="5 - 100 ms" Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                        </Grid>

                        <!-- ================================================= -->
                        <!-- TRIGGER SETTINGS                                  -->
                        <!-- ================================================= -->

                        <Grid Margin="0,12,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Trigger threshold -->

                            <StackPanel Grid.Column="0">

                                <TextBlock Text="Tetik Eşiği" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <TextBox Text="{Binding GamepadTriggerThreshold,                                                         Mode=TwoWay,                                                         UpdateSourceTrigger=PropertyChanged}" ToolTip="Tetiklerin aktif kabul edileceği eşik. Analog tetiklerde seviye, dijital tetiklerde 0/1 değeri uygulanır." Style="{StaticResource TextInputStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="0.0 &lt; değer ≤ 1.0" Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                            <!-- Trigger debounce -->

                            <StackPanel Grid.Column="2">

                                <TextBlock Text="Tetik Debounce" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <TextBox Text="{Binding GamepadTriggerDebounceSamples,                                                         Mode=TwoWay,                                                         UpdateSourceTrigger=PropertyChanged}" ToolTip="Tetik durum değişikliğinin kabul edilmesi için gereken ardışık örnek sayısı." Style="{StaticResource TextInputStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="1 - 20 örnek" Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                            <!-- Fire interval -->

                            <StackPanel Grid.Column="4">

                                <TextBlock Text="Fire Minimum Aralığı" Style="{StaticResource SettingsFieldLabelStyle}"/>

                                <TextBox Text="{Binding GamepadFireMinimumIntervalMs,                                                         Mode=TwoWay,                                                         UpdateSourceTrigger=PropertyChanged}" ToolTip="İki ayrı Fire tetiklemesi arasındaki minimum süre." Style="{StaticResource TextInputStyle}"/>

                                <TextBlock Margin="0,4,0,0" Text="0 - 10000 ms" Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                        </Grid>

                        <!-- ================================================= -->
                        <!-- BUTTON BINDINGS                                   -->
                        <!-- ================================================= -->

                        <Border Height="1" Margin="0,13,0,10" Background="{DynamicResource BorderBrush}"/>

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>

                                <TextBlock Text="Kontrol Atamaları" Style="{StaticResource CardTitleTextStyle}"/>

                                <TextBlock Margin="0,3,0,0" Text="Kontrolü listeden seçin veya Değiştir'e basarak gamepad üzerinden atayın." Style="{StaticResource SettingsFieldHintStyle}"/>

                            </StackPanel>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Aynı kontrol iki aksiyona atanamaz" Style="{StaticResource SettingsFieldHintStyle}"/>

                        </Grid>

                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding GamepadBindings}" HorizontalContentAlignment="Stretch">

                            <ItemsControl.ItemTemplate>

                                <DataTemplate>

                                    <Border Margin="0,0,0,5" Padding="10,7" HorizontalAlignment="Stretch" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">

                                        <Grid>

                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="230"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">

                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>

                                                <TextBlock Margin="0,2,0,0" Text="{Binding ActionId}" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"/>

                                            </StackPanel>

                                            <ComboBox Grid.Column="1" MinHeight="30" VerticalAlignment="Center" ItemsSource="{Binding AvailableControls}" DisplayMemberPath="DisplayName" SelectedValuePath="Control" SelectedValue="{Binding SelectedControl,                                                                               Mode=TwoWay,                                                                               UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditManually}"/>

                                            <Button Grid.Column="3" MinWidth="76" VerticalAlignment="Center" Content="{Binding CaptureButtonText}" Command="{Binding DataContext.ToggleGamepadControlCaptureCommand,                                                         RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}" Style="{StaticResource CompactSecondaryButtonStyle}"/>

                                        </Grid>

                                    </Border>

                                </DataTemplate>

                            </ItemsControl.ItemTemplate>

                        </ItemsControl>

                        <TextBlock Margin="2,5,0,0" Text="Fiziksel atamada önce nötr durum beklenir. Aynı kontrol başka bir aksiyondaysa iki atama otomatik olarak yer değiştirir." Style="{StaticResource SettingsFieldHintStyle}"/>

                    </StackPanel>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>