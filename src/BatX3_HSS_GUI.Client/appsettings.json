{
  "Application": {
    "Name": "BAT-X3_HSS_GUI Client"
  },

  "Network": {
    "ServerIp": "127.0.0.1",
    "LocalBindIp": "127.0.0.1",

    "Command": {
      "RemotePort": 2023,
      "LocalPort": 0,
      "ResponseTimeoutMs": 300
    },

    "Video": {
      "ListenPort": 2024,
      "ReceiveBufferBytes": 4194304
    },

    "Detection": {
      "ListenPort": 2025,
      "StaleTimeoutMs": 500
    }
  },

  "Input": {
    "Shortcuts": [
      {
        "ActionId": "Weapon.Fire",
        "Key": "F",
        "Modifiers": "None"
      },
      {
        "ActionId": "Motion.Up",
        "Key": "W",
        "Modifiers": "None"
      },
      {
        "ActionId": "Motion.Down",
        "Key": "S",
        "Modifiers": "None"
      },
      {
        "ActionId": "Motion.Left",
        "Key": "A",
        "Modifiers": "None"
      },
      {
        "ActionId": "Motion.Right",
        "Key": "D",
        "Modifiers": "None"
      }
    ],

    "Gamepad": {
      "Enabled": true,
      "ActiveDeviceId": null,
      "InvertY": true,
      "Deadzone": 0.15,
      "TriggerThreshold": 0.5,
      "TriggerDebounceSamples": 3,
      "PollingIntervalMs": 10,
      "FireMinimumIntervalMs": 1000,
      "Bindings": [
        {
          "ActionId": "Motion.Precision",
          "Control": "RightTrigger"
        },
        {
          "ActionId": "Weapon.Fire",
          "Control": "RightShoulder"
        },
        {
          "ActionId": "Weapon.ArmToggle",
          "Control": "LeftShoulder"
        },
        {
          "ActionId": "Mode.Manual",
          "Control": "Menu"
        },
        {
          "ActionId": "Mode.Idle",
          "Control": "View"
        },
        {
          "ActionId": "Mode.EmergencyStop",
          "Control": "B"
        }
      ]
    }
  }
}