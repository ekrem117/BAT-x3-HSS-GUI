<UserControl x:Class="BatX3_HSS_GUI.Client.Controls.Parameters.NumericParameterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="12"
            Margin="0,0,0,8"
            BorderThickness="1">

        <StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center"
                           Text="{Binding DisplayName}" />

                <TextBox Grid.Column="1"
                         Margin="8,0"
                         VerticalContentAlignment="Center"
                         Text="{Binding NumericText,
                                        UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           Text="{Binding Unit}" />

                <Button Grid.Column="3"
                        Width="70"
                        Margin="4,0"
                        Content="GET"
                        IsEnabled="{Binding CanRead}"
                        Command="{Binding ReadCommand}" />

                <Button Grid.Column="4"
                        Width="70"
                        Margin="4,0"
                        Content="SET"
                        IsEnabled="{Binding CanWrite}"
                        Command="{Binding WriteCommand}" />
            </Grid>

            <TextBlock Margin="228,6,0,0"
                       Text="{Binding ErrorMessage}"
                       TextWrapping="Wrap" />

        </StackPanel>

    </Border>

</UserControl>